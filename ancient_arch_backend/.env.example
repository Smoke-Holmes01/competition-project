# Browser-visible asset base. Leave empty for same-origin nginx proxy so model URLs
# stay relative, e.g. /models_glb/1.glb. Set to https://your-domain only for direct
# cross-origin asset delivery.
PUBLIC_ASSET_BASE_URL=

# Optional local development CORS, e.g. http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=
