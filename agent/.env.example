SILICONFLOW_BASE_URL=http://<your-server>/v1
SILICONFLOW_API_KEY=<optional-or-real-key>
SILICONFLOW_MODEL=<deployed-qwen-model-name>
API_MODEL_DISPLAY_NAME=Qwen3.5-397B-A17B

# Optional OpenAI-compatible text-to-speech endpoint. If omitted or unavailable,
# the frontend falls back to browser Web Speech automatically.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=boy
TTS_RESPONSE_FORMAT=mp3

LOCAL_MODEL_PATH=/home/yy/models/Qwen3.5-9B
LOCAL_MODEL_NAME=Qwen3.5-9B

# Internal service-to-service URL. In production this can stay on localhost if nginx
# exposes public assets through the same origin as the frontend.
BACKEND_BASE_URL=http://127.0.0.1:8000

# Browser-visible asset base. Leave empty for same-origin nginx proxy so model URLs
# stay relative, e.g. /models_glb/1.glb. Set to https://your-domain only for direct
# cross-origin asset delivery.
PUBLIC_ASSET_BASE_URL=

# Optional local development CORS, e.g. http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=

KB_PDF_PATH=../知识库.pdf
