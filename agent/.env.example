# Copy to .env, then fill your own keys. Real .env files are never committed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

BACKEND_BASE_URL=http://127.0.0.1:8000
# Empty means browser-visible /models_glb/... and /models/... same-origin URLs.
PUBLIC_ASSET_BASE_URL=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Defaults use absolute paths relative to this Agent project, no need to set these.
# DATA_DIR=storage/runtime
# KB_DIR=storage/index
# KB_SEED=storage/kb/chunks.json
# METADATA_PATH=../ancient_arch_backend/data/model_metadata.json
# METADATA_OVERRIDES_PATH=../ancient_arch_backend/data/metadata_overrides.json

MAX_IMAGES=5
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_TOOL_CALLS=8
TURN_TIMEOUT_SECONDS=240
REQUEST_TIMEOUT_SECONDS=60
CONTEXT_CHAR_BUDGET=32000
OUTPUT_TOKENS=2048
RAG_TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
